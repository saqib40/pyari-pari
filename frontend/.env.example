# Copy to .env.local (gitignored). These are baked into the app when it is bundled,
# so restart Metro or rebuild after changing them.

# The Pari backend. On an Android phone over USB, `adb reverse tcp:4000 tcp:4000`
# makes the phone's localhost reach the laptop.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Must match PARI_API_KEY in backend/.env.
EXPO_PUBLIC_API_KEY=pari-dev-key

# true: long-press a "Link sent" ledger row or the shop QR to simulate a customer
# paying. Needs the backend in PARI_PAYTM_MODE=mock (its default).
EXPO_PUBLIC_DEMO_TOOLS=false
