# Sarvam (one key covers speech-to-text, text-to-speech and the LLM)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v4-flash
PARI_TTS_SPEAKER=simran_enhi_customer
# Speaking pace, 0.5 to 2.0
PARI_TTS_PACE=1.15
SARVAM_CHAT_MODEL=sarvam-105b-conversations
# Optional: none | low | high | max. Leave empty for the model default.
SARVAM_REASONING_EFFORT=

# Server
PORT=4000
LOG_LEVEL=info
PARI_API_KEY=pari-dev-key
# Browser clients allowed to call the API (Vite on 5173, Expo web on 8081)
PARI_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Shop QR. Set a UPI ID (name@bank) to make the QR a real UPI payment code;
# leave empty for a demo QR that no UPI app can pay.
PARI_UPI_ID=
# true: a fresh database also gets a few days of past entries, for demos
PARI_DEMO_SEED=false

# Database. Leave DATABASE_URL empty to use the embedded Postgres (PGlite) in PARI_PGLITE_DIR.
# With docker compose: postgres://pari:pari@localhost:5432/pari
DATABASE_URL=
PARI_PGLITE_DIR=.data/pglite

# Paytm: mock (simulated, default) or sandbox (real Paytm staging)
PARI_PAYTM_MODE=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_HOST=https://securegw-stage.paytm.in
# Public base URL Paytm can reach (ngrok), used for the callback URL in sandbox mode
PARI_PUBLIC_URL=

# CLI
PARI_API_URL=http://localhost:4000
